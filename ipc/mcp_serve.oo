// # oocut Streaming MCP Server
//
// Logline: JSON-RPC 2.0 stdio server exposing column slicing, byte indexing, and delimiter field extraction.
//
// Setup: Bridges standard input/output streaming JSON-RPC to the stream cutting engine using bounded capability tokens.
//
// Beats:
//   1. Handle MCP initialize handshake with server metadata.
//   2. Expose tools/list catalogue with five sovereign cut extraction tools.
//   3. Dispatch tools/call for cut_fields, cut_bytes, cut_characters, cut_slice, and cut_demo.
//   4. Deliver streaming JSON-RPC responses over standard output.

import "core/cut_types.oo";
import "core/range_parser.oo";
import "core/cut_engine.oo";
import "core/cut_demo.oo";
import "render/cut_json.oo";
import "ipc/json_field.oo";

fn build_error(id: String, code: Int, msg: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":"
        + to_string(code) + ",\"message\":\"" + json_escape(msg) + "\"}}\n";
}

fn build_tool_result(id: String, text: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\""
        + json_escape(text) + "\"}]}}\n";
}

pub fn render_mcp_init(id: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id
        + ",\"result\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"oocut\",\"version\":\"0.2.0\"}}}\n";
}

pub fn render_mcp_tools_list(id: String) -> String {
    let mut out: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"tools\":[";
    out = out + "{\"name\":\"cut_fields\",\"description\":\"Extract delimiter-separated fields from text or file.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"path\":{\"type\":\"string\"},\"fields\":{\"type\":\"string\"},\"delimiter\":{\"type\":\"string\"},\"output_delimiter\":{\"type\":\"string\"},\"only_delimited\":{\"type\":\"boolean\"},\"complement\":{\"type\":\"boolean\"}},\"required\":[\"fields\"]}}";
    out = out + ",{\"name\":\"cut_bytes\",\"description\":\"Extract specific 1-based byte positions from text or file.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"path\":{\"type\":\"string\"},\"bytes\":{\"type\":\"string\"},\"output_delimiter\":{\"type\":\"string\"},\"complement\":{\"type\":\"boolean\"}},\"required\":[\"bytes\"]}}";
    out = out + ",{\"name\":\"cut_characters\",\"description\":\"Extract 1-based UTF-8 character positions from text or file.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"path\":{\"type\":\"string\"},\"characters\":{\"type\":\"string\"},\"output_delimiter\":{\"type\":\"string\"},\"complement\":{\"type\":\"boolean\"}},\"required\":[\"characters\"]}}";
    out = out + ",{\"name\":\"cut_slice\",\"description\":\"Universal stream slicer supporting byte, character, and field modes.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"path\":{\"type\":\"string\"},\"mode\":{\"type\":\"string\"},\"spec\":{\"type\":\"string\"},\"delimiter\":{\"type\":\"string\"}},\"required\":[\"spec\"]}}";
    out = out + ",{\"name\":\"cut_demo\",\"description\":\"Return synthetic Unix passwd and TSV column extraction demonstration.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}";
    out = out + "]}}\n";
    return out;
}

fn parse_mcp_delim(delim_str: String) -> Int {
    if delim_str == "\\t" || delim_str == "tab" {
        return 9;
    }
    if delim_str == ":" || delim_str == "colon" {
        return 58;
    }
    if delim_str == "," || delim_str == "comma" {
        return 44;
    }
    if delim_str == "|" || delim_str == "pipe" {
        return 124;
    }
    if chars_len(delim_str) > 0 {
        return byte_at(delim_str, 0);
    }
    return 9;
}

fn load_cut_content(fr: &FsReadCap, req: String) -> String {
    let path: String = extract_json_str(req, "path");
    let raw_data: String = extract_json_str(req, "data");
    if chars_len(path) > 0 {
        let r: Result[String, String] = read_file(fr, path);
        if r.is_ok() {
            let v: String = match r { Ok(s) => s, Err(_) => "" };
            return v;
        }
        return raw_data;
    }
    if chars_len(raw_data) > 0 {
        return raw_data;
    }
    return build_demo_passwd();
}

pub fn handle_mcp_call(
    fr: &FsReadCap,
    id: String,
    tool_name: String,
    req: String
) -> String {
    if tool_name == "cut_fields" {
        let content: String = load_cut_content(fr, req);
        let fields_str: String = extract_json_str(req, "fields");
        let delim_str: String = extract_json_str(req, "delimiter");
        let out_delim: String = extract_json_str(req, "output_delimiter");
        let only_delim: Bool = extract_json_bool(req, "only_delimited", false);
        let comp: Bool = extract_json_bool(req, "complement", false);

        let mut cfg: CutConfig = default_cut_config();
        cfg.mode = "fields";
        cfg.ranges = parse_range_list(fields_str);
        cfg.delimiter = parse_mcp_delim(delim_str);
        cfg.output_delimiter = out_delim;
        cfg.only_delimited = only_delim;
        cfg.complement = comp;

        let res: CutResult = execute_cut(content, cfg);
        return build_tool_result(id, result_to_json(res));
    }

    if tool_name == "cut_bytes" {
        let content: String = load_cut_content(fr, req);
        let bytes_str: String = extract_json_str(req, "bytes");
        let out_delim: String = extract_json_str(req, "output_delimiter");
        let comp: Bool = extract_json_bool(req, "complement", false);

        let mut cfg: CutConfig = default_cut_config();
        cfg.mode = "bytes";
        cfg.ranges = parse_range_list(bytes_str);
        cfg.output_delimiter = out_delim;
        cfg.complement = comp;

        let res: CutResult = execute_cut(content, cfg);
        return build_tool_result(id, result_to_json(res));
    }

    if tool_name == "cut_characters" {
        let content: String = load_cut_content(fr, req);
        let chars_str: String = extract_json_str(req, "characters");
        let out_delim: String = extract_json_str(req, "output_delimiter");
        let comp: Bool = extract_json_bool(req, "complement", false);

        let mut cfg: CutConfig = default_cut_config();
        cfg.mode = "chars";
        cfg.ranges = parse_range_list(chars_str);
        cfg.output_delimiter = out_delim;
        cfg.complement = comp;

        let res: CutResult = execute_cut(content, cfg);
        return build_tool_result(id, result_to_json(res));
    }

    if tool_name == "cut_slice" {
        let content: String = load_cut_content(fr, req);
        let mode_str: String = extract_json_str(req, "mode");
        let spec_str: String = extract_json_str(req, "spec");
        let delim_str: String = extract_json_str(req, "delimiter");

        let mut cfg: CutConfig = default_cut_config();
        cfg.mode = if mode_str == "bytes" || mode_str == "chars" { mode_str } else { "fields" };
        cfg.ranges = parse_range_list(spec_str);
        cfg.delimiter = parse_mcp_delim(delim_str);

        let res: CutResult = execute_cut(content, cfg);
        return build_tool_result(id, result_to_json(res));
    }

    if tool_name == "cut_demo" {
        let res: CutResult = build_demo_result();
        return build_tool_result(id, demo_to_json(res));
    }

    return build_error(id, -32601, "Unknown tool: " + tool_name);
}

pub fn handle_mcp_message(fr: &FsReadCap, req: String) -> String {
    let id_str: String = extract_json_str(req, "id");
    let id: String = if chars_len(id_str) > 0 { "\"" + id_str + "\"" } else { "1" };
    let method: String = extract_json_str(req, "method");

    if method == "initialize" {
        return render_mcp_init(id);
    }
    if method == "notifications/initialized" {
        return "";
    }
    if method == "tools/list" {
        return render_mcp_tools_list(id);
    }
    if method == "tools/call" {
        let tool_name: String = extract_json_str(req, "name");
        return handle_mcp_call(fr, id, tool_name, req);
    }
    if method == "shutdown" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}\n";
    }
    return build_error(id, -32601, "Method not found: " + method);
}

pub fn run_mcp_server(fr: &FsReadCap) {
    let mut buf: String = "";
    let mut running: Bool = true;
    while running {
        let r: Result[String, String] = oo_read_stdin_chunk(fr, 4096);
        if !r.is_ok() {
            running = false;
        } else {
            let chunk: String = match r { Ok(s) => s, Err(_) => "" };
            if chars_len(chunk) == 0 {
                running = false;
            } else {
                buf = buf + chunk;
                let mut nl_pos: Int = find_sub_char(buf, "\n");
                while nl_pos >= 0 {
                    let line: String = str_slice(buf, 0, nl_pos);
                    buf = str_slice(buf, nl_pos + 1, chars_len(buf));
                    let trimmed: String = str_trim(line);
                    if chars_len(trimmed) > 0 {
                        let resp: String = handle_mcp_message(fr, trimmed);
                        if chars_len(resp) > 0 {
                            print(resp);
                        }
                    }
                    nl_pos = find_sub_char(buf, "\n");
                }
            }
        }
    }
}
