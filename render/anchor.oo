// # oocut Render Test Anchor
//
// Logline: Verification anchor for terminal themes, card views, and JSON serialization.
//
// Setup: Demands no ambient authority; exercises rendering functions against fixture results.
//
// Beats:
//   1. Verify theme palette resolution and ANSI escape sequences.
//   2. Verify demo view layout formatting and frame delimiters.
//   3. Verify JSON serialization structure and escaping.
//   4. Deliver unified render test runner returning boolean status.

import "core/cut_demo.oo";
import "core/cut_engine.oo";
import "render/cut_theme.oo";
import "render/cut_view.oo";
import "render/cut_json.oo";

pub fn test_themes() -> Bool {
    let th_ember: ThemePalette = get_theme("ember");
    if th_ember.name != "ember" || chars_len(th_ember.accent) == 0 {
        print("FAIL: ember theme mismatch\n");
        return false;
    }

    let th_ocean: ThemePalette = get_theme("ocean");
    if th_ocean.name != "ocean" {
        print("FAIL: ocean theme mismatch\n");
        return false;
    }

    let th_mono: ThemePalette = get_theme("monochrome");
    if th_mono.name != "monochrome" {
        print("FAIL: monochrome theme mismatch\n");
        return false;
    }
    return true;
}

pub fn test_view() -> Bool {
    let res: CutResult = build_demo_result();
    let th: ThemePalette = get_theme("ember");
    let view: String = render_demo_view(res, th);

    if !str_contains(view, "oocut 0.2.0") {
        print("FAIL: demo view missing tool title\n");
        return false;
    }
    if !str_contains(view, "root -> /root -> /bin/bash") {
        print("FAIL: demo view missing extracted content\n");
        return false;
    }
    return true;
}

pub fn test_json() -> Bool {
    let res: CutResult = build_demo_result();
    let j: String = result_to_json(res);

    if !str_contains(j, "\"tool\": \"oocut\"") {
        print("FAIL: json missing tool key\n");
        return false;
    }
    if !str_contains(j, "\"mode\": \"fields\"") {
        print("FAIL: json missing mode key\n");
        return false;
    }
    if !str_contains(j, "root -> /root -> /bin/bash") {
        print("FAIL: json missing line entry\n");
        return false;
    }
    return true;
}

pub fn run_render_tests() -> Bool {
    print("Running oocut render tests...\n");
    if !test_themes() {
        return false;
    }
    print("  ✓ cut_theme tests passed\n");

    if !test_view() {
        return false;
    }
    print("  ✓ cut_view tests passed\n");

    if !test_json() {
        return false;
    }
    print("  ✓ cut_json tests passed\n");

    return true;
}
